# HUST Course Advisor & Degree Audit Engine
# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=

# Cấu hình Model Gemini
GEMINI_MODEL=gemini-2.5-flash
# Model dự phòng khi model chính lỗi/quá tải
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Embedding đa ngôn ngữ cho RAG (auto = dùng Gemini khi có API key)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=auto
# Phân loại intent: auto/llm = Gemini (dự phòng luật từ khóa), keyword = chỉ luật từ khóa
INTENT_ROUTER_MODE=auto

# Cấu hình Server
API_HOST=0.0.0.0
API_PORT=8000
